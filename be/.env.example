OPENAI_API_KEY=
# Optional: use a local merged V2 checkpoint instead of the public Hub model.
MODEL_PATH=LongGrainRice/kimchi-test
# Optional: choose another compatible recipe model.
RECIPE_MODEL=gpt-4.1-mini
# Comma-separated non-local frontend origins. Localhost and 127.0.0.1 ports are
# allowed automatically so Vite can use the next available development port.
CORS_ORIGINS=http://localhost:5173
# Optional override. Defaults to localhost/127.0.0.1 on any port.
# CORS_ORIGIN_REGEX=^https?://(?:localhost|127\\.0\\.0\\.1)(?::\\d+)?$
# Image-upload safety limits (10 MB and 40 megapixels by default).
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
# Set true only while diagnosing parser/model output locally.
INCLUDE_RAW_OUTPUT=false
